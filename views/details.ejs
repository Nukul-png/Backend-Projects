<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Detail</title>
    <style>
        body{
            font-family: Arial;
            background: #f4f6f8;
            text-align: center;
        }
        .card {
            background: white;
            padding: 20px;
            margin: 50px auto;
            width: 300px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            border-radius: 10px;
        }
        h2 {
            color: #333;
        }

        p {
            margin: 10px 0;
        }
        a {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: white;
            background: #4CAF50;
            padding: 8px 15px;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>User Details</h2>
        <p><strong>ID:</strong><%=user.id%></p>
        <p><strong>Username</strong><%= user.username %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Password:</strong> <%= user.password %></p>
        <a href="/users">Back</a>
    </div>
</body>
</html>